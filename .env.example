NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# The live origin, with no trailing slash. Canonical URLs, the sitemap,
# robots.txt, and Open Graph image URLs are all built from this. If it is
# wrong, you tell Google the wrong URL is authoritative — set it to the
# domain that actually serves the site. Defaults to https://padlock.extention.in
NEXT_PUBLIC_SITE_URL=https://padlock.extention.in

# Set to "true" once the Chrome Web Store listing is approved and live.
# Until then, /install shows a "coming soon" state instead of a button that
# would 404, and the site's structured data omits the store link entirely.
NEXT_PUBLIC_EXTENSION_PUBLISHED=false

# Optional. Only used server-side by /api/account/delete to remove the
# Supabase Auth identity record after account data is deleted. Never expose
# this to the client, never prefix it with NEXT_PUBLIC. Find it in
# Supabase → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
