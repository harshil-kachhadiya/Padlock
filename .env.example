NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional. Only used server-side by /api/account/delete to remove the
# Supabase Auth identity record after account data is deleted. Never expose
# this to the client, never prefix it with NEXT_PUBLIC_. Find it in
# Supabase → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
